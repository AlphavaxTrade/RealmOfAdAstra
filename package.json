{
  "name": "realm-of-astra",
  "version": "2.0.0-alpha.1",
  "description": "Realm of Astra - Web3 GameFi RPG on Avalanche",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "build": "vite build && node scripts/sikistir.mjs",
    "preview": "vite preview --port 5180 --strictPort",
    "test": "node tests/run_all.mjs",
    "olu-kod": "knip --no-progress --reporter compact",
    "lint": "eslint server js scripts tests contracts eslint.config.js --max-warnings=13",
    "gizli-tara": "node scripts/gizli-tara.mjs",
    "audit-uretim": "node scripts/audit-uretim.mjs",
    "kapsam": "c8 node tests/run_all.mjs",
    "kapsam-kontrol": "node scripts/kapsam-kontrol.mjs",
    "yuk": "node scripts/yuk/yuk.mjs",
    "yuk-kontrol": "node scripts/yuk/kontrol.mjs",
    "yuk-kapi": "node scripts/yuk/kapi-olcum.mjs",
    "kontrol": "node scripts/kontrol.mjs",
    "hizli": "node scripts/kontrol.mjs --hizli",
    "hook-kur": "node scripts/hook-kur.mjs",
    "sim": "node scripts/simulasyon/yil.mjs",
    "senaryo-kur": "node scripts/senaryo/kur.mjs",
    "tarayici": "node scripts/tarayici/senaryo.mjs"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "ganache": "^7.9.2",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "phaser": "^4.2.1",
    "playwright": "^1.64.1",
    "solc": "^0.8.37",
    "three": "^0.186.1",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "nodemailer": "^10.0.16",
    "qrcode": "^1.5.4"
  }
}
