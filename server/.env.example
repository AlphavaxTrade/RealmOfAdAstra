# Realm of AdAstra sunucusu — ayar örneği
# Bu dosyayı "server/.env" adıyla kopyalayıp doldurun. server/.env GitHub'a GÖNDERİLMEZ.

# Sunucunun dinleyeceği kapı
PORT=8080

# Yönetici paneli şifresi (uzun, rastgele bir metin; kimseyle paylaşmayın)
ADMIN_TOKEN=

# Oyun cüzdanının GİZLİ ANAHTARI (B seçeneği: sunucu çekimleri kendisi gönderir).
# - Bu cüzdanda yalnızca oyunun ihtiyacı kadar ADASTRA ve işlem ücreti için biraz AVAX tutun.
# - Boş bırakılırsa sunucu hiçbir şey göndermez; ödemeler yönetici panelinde onay bekler.
GAME_WALLET_PRIVATE_KEY=

# Anahtar boşken yatırmaları izlemek için oyun cüzdanının adresi (anahtar varsa gerekmez)
GAME_WALLET_ADDRESS=

# auto: sunucu gönderir · manual: yönetici panelinden "ödemeleri gönder" ile
PAYOUT_MODE=auto

# Güvenlik sınırı: bir haftada oyunculara gönderilebilecek en fazla ADA
WEEKLY_SEND_CAP_ADA=100000000

# En küçük çekim miktarı (ADA)
MIN_WITHDRAW_ADA=1000

# Oyunun açılış fiyatı (1 ADASTRA kaç $). Boş bırakılırsa sunucunun ilk okuduğu fiyat kullanılır.
LAUNCH_PRICE_USD=

# Kayıt dosyası (Docker ile kurulumda bu satıra gerek yok; kayıt kalıcı /data klasöründe tutulur)
# DB_FILE=./data/realm.db

# Avalanche bağlantı adresleri (virgülle; biri çalışmazsa sıradakine geçer)
# RPC_URLS=https://api.avax.network/ext/bc/C/rpc,https://avalanche-c-chain-rpc.publicnode.com

# ── Hesaplar ve e-posta ──────────────────────────────────────────────
# Oyunun herkese açık adresi (e-postadaki doğrulama/sıfırlama/cüzdan onayı bağlantıları buraya gider)
# Oyun dosyaları Vercel gibi başka bir adresten sunuluyorsa o adres (ör. https://realmofadastra.vercel.app); virgülle birden çok
CORS_ORIGINS=
PUBLIC_URL=https://oyun.alanadin.com
# E-posta gönderimi (ör. smtps://kullanici:sifre@smtp.saglayici.com:465). Boşsa e-postalar gönderilmez, günlüğe yazılır.
SMTP_URL=
MAIL_FROM=Realm of AdAstra <no-reply@alanadin.com>
# Sunucunun önünde Caddy/Nginx varsa 1 (gerçek ziyaretçi adresini görmek için)
TRUST_PROXY=1

# ── Cüzdandan ödeme (RealmPayments sözleşmesi) ───────────────────────
# Sözleşme adresi: contracts/deploy.mjs çıktısındaki PAYMENTS_CONTRACT (boşsa cüzdandan ödeme kapalı)
PAYMENTS_CONTRACT=
# ADA oranları sözleşmesi (RealmRates): contracts/deploy.mjs çıktısındaki RATES_CONTRACT. Bütün oranlar (yakım, kasalar, çark,
# zindan harcı, piyango, pazar, çekim) buradan okunur; değişiklik 24 saat sonra geçerli. Boşsa oyunun kendi ayarları.
RATES_CONTRACT=
# Sözleşmedeki feeGas ile aynı (komisyon = gaz fiyatı × bu ≈ ağ ücreti kadar)
PAY_FEE_GAS=100000
# 43114 = Avalanche (gerçek), 43113 = Fuji (deneme)
CHAIN_ID=43114

# ── Oyun Kasası (her oyuncuya sunucunun yönettiği cüzdan) ────────────
# 64 haneli gizli ana anahtar: openssl rand -hex 32
# ⚠️ KAYBEDERSEN oyuncu kasalarına bir daha erişilemez; ÇALINIRSA kasalar risk altındadır. Güvenli yerde YEDEKLE.
KASA_MASTER_KEY=
# Kasada en az bu kadar AVAX yoksa kasa kullanılmaz (aktarım işlem ücreti için)
KASA_MIN_AVAX=0.003
# Kasadan harcanan ADA bu kadar birikince (ya da 24 saatte bir) oyuna aktarılır
KASA_MIN_SETTLE=50
# Kasa üst sınırı: kasada "günlük ortalama harcama × KASA_CAP_DAYS"ten fazlası birikirse fazlası oyuncunun bağlı cüzdanına
# kendiliğinden geri gönderilir. Yeni oyuncu için alt sınır KASA_CAP_FLOOR_ADA (fiyat çarpanıyla büyür). 0 = kapalı.
KASA_CAP_DAYS=30
KASA_CAP_FLOOR_ADA=20000

# ── Sıcak / soğuk cüzdan (önerilir) ──────────────────────────────────
# Oyun cüzdanının anahtarı sunucuda durur ("sıcak"). İçinde yalnız HOT_WALLET_WEEKS haftalık ihtiyaç kadar ADA kalır;
# fazlası günde bir RESERVE_WALLET adresine gönderilir. RESERVE_WALLET: donanım cüzdanının (Ledger) ADRESİ — anahtarı DEĞİL.
RESERVE_WALLET=
HOT_WALLET_WEEKS=1
# Geçmiş yokken (ilk haftalar) oyun cüzdanında en az bu kadar ADA kalsın
HOT_WALLET_MIN_ADA=0
# Ödeme sözleşmesinin sahibi olması gereken donanım cüzdanı adresi (yönetici paneli denetler)
CONTRACT_OWNER=
# Oyun cüzdanı azalınca uyarı e-postası buraya gider
ADMIN_EMAIL=

# ── Trade sitesi (AlphAvax) geliri ───────────────────────────────────
# Trade sitesindeki harcamaların %40'ı ADASTRA olarak gönderilir. FROM: trade sitesinin ödemeyi yaptığı cüzdan
# (birden fazlaysa virgülle). TO: paranın geldiği adres (boşsa oyun cüzdanı). Gelen her ödeme bir kez sayılır ve
# her oyun harcaması gibi dağıtılır: %5 yakım, %6 temel gelir, %3 yapımcı payı, %86 ödül kasaları.
# NOT: TO oyun cüzdanı değilse (ör. yedek cüzdan), yakım/yapımcı ödemeleri oyun cüzdanından yapıldığı için oyun
# cüzdanını yedekten beslemeyi unutma (yönetici paneli azalınca uyarır).
PARTNER_INCOME_FROM=
PARTNER_INCOME_TO=

# ── Deneme ───────────────────────────────────────────────────────────
# 1 = deneme sunucusu (test menüsü, bot rakip, taklit kasa/ödeme). GERÇEK SUNUCUDA ASLA 1 YAPMA.
TEST_MODE=0
